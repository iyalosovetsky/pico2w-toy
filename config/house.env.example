# ~/.config/lcdtoy/house.env - ДІМ (app/house.py): Home Assistant and the house plan.
# Copy it there and keep it private:   install -m 600 config/house.env.example ~/.config/lcdtoy/house.env
#
# The token: in Home Assistant create a separate user WITHOUT admin rights (Settings - People - Add person,
# allow login, «Administrator» off), log in as that user, Profile - Security - Long-lived access tokens -
# Create token. It can switch the lights but not change HA's settings.

# HA addresses, tried in turn: the home LAN first, then the public one
HA_URL=http://10.80.39.78:8123,https://hass.ibotz.space
HA_TOKEN=

# the house3d plan server (the home LAN, no auth): GET /plan and /layout
PLAN_URL=http://10.80.39.14:8095

# more entities that ask «Так / Ні» before they act (gates, doors and locks always ask), comma-separated
CONFIRM=
