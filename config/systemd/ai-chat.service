[Unit]
Description=Local AI chat on the LCD console (tty7)
After=systemd-user-sessions.service
Conflicts=getty@tty7.service lcd-menu.service
# back to the menu when the chat ends
OnSuccess=lcd-menu.service
OnFailure=lcd-menu.service

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=LANG=C.UTF-8 TERM=linux PYTHONIOENCODING=utf-8
EnvironmentFile=-/etc/default/lcd-ai-chat
# tty7 is the LCD's console (fbcon=map in cmdline.txt); 6x10 font for the chat
ExecStartPre=+/usr/bin/setfont -C /dev/tty7 /usr/share/consolefonts/Uni2-Fixed6x10.psf.gz
ExecStartPre=+/bin/chvt 7
ExecStopPost=+/bin/chvt 1
ExecStart=/usr/bin/python3 @APP_DIR@/ai_chat.py
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
