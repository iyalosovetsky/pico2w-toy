[Unit]
Description=Launcher menu on the PicoCalc screen
After=systemd-user-sessions.service
OnSuccess=lcd-console.service

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/default/lcd-toy
# wait for the LCD framebuffer
ExecStartPre=/bin/sh -c "for i in $(seq 30); do grep -qs mipi /sys/class/graphics/fb*/name && exit 0; sleep 1; done; exit 1"
# the menu draws on tty8 switched to graphics mode, so no console text gets over it
ExecStartPre=+/usr/local/bin/lcd-vt graphics 8
ExecStart=/usr/bin/python3 @APP_DIR@/menu.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
