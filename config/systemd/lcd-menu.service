[Unit]
Description=Launcher menu on Waveshare 1.44" LCD HAT
After=systemd-user-sessions.service
# keep the text console from drawing over the menu/games
Conflicts=getty@tty1.service
OnSuccess=lcd-console.service

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStartPre=/bin/sh -c "for i in $(seq 30); do [ -e /dev/fb0 ] && exit 0; sleep 1; done; exit 1"
ExecStartPre=+/bin/sh -c "echo 0 > /sys/class/graphics/fbcon/cursor_blink"
ExecStart=/usr/bin/python3 @APP_DIR@/menu.py
ExecStopPost=+/bin/sh -c "echo 1 > /sys/class/graphics/fbcon/cursor_blink"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
