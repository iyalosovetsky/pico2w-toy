# /etc/udev/rules.d/61-rtl-sdr.rules - RTL2832U SDR sticks: open to everyone, so the menu's SDR
# item (a service, not a logged-in seat - the package's "uaccess" rule does not cover it) can use them
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", MODE="0666"
