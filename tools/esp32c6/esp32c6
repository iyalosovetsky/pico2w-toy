#!/bin/bash
# Control the ESP32-C6-Zero signal generator (tools/esp32c6/main.py) over the UART.
#
#   esp32c6 shape sine freq 2k  shape: square sine triangle saw; frequency (Hz, k, M)
#   esp32c6 duty 25             duty (%) of the square wave - commands combine in any order
#   esp32c6 on | off            start / stop the output
#   esp32c6 get | ping          show the settings / check the link
#   esp32c6 flash main.py       upload a new program over the UART and restart the board
#
# Every command prints the board's answer ("ok shape=... freq=... ..." or "err ...").
# ESP32C6_PORT overrides the port (default /dev/serial0, 115200 baud).
PORT=${ESP32C6_PORT:-/dev/serial0}

usage() {
    sed -n '2,11s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}
[ $# -eq 0 ] && set -- get
case "$1" in -h|--help|help) usage ;; esac

stty -F "$PORT" 115200 raw -echo -hupcl 2>/dev/null || { echo "can't open $PORT" >&2; exit 1; }
exec 3<>"$PORT"

send() {  # send one command line (+ a file for put), print the answer
    local reply file=$2 wait=2
    while read -r -t 0.05 -u 3 _; do :; done  # drop anything stale
    printf '%s\n' "$1" >&3
    if [ -n "$file" ]; then
        cat "$file" >&3
        wait=$(( $(stat -c %s "$file") / 5000 + 10 ))
    fi
    if read -r -t "$wait" -u 3 reply; then
        echo "${reply%$'\r'}"
        [[ $reply == err* ]] && status=1
    else
        echo "no answer from the ESP32-C6 on $PORT" >&2
        exit 1
    fi
}

status=0
while [ $# -gt 0 ]; do
    case "$1" in
        freq|duty|shape)
            [ $# -ge 2 ] || usage 1
            send "$1 $2"
            shift 2 ;;
        flash)
            [ $# -ge 2 ] && [ -f "$2" ] || usage 1
            send "put $(basename "$2") $(stat -c %s "$2")" "$2"
            [ $status = 0 ] && send reset
            shift 2 ;;
        on|off|get|ping)
            send "$1"
            shift ;;
        *)
            echo "unknown: $1" >&2
            usage 1 ;;
    esac
done
exit $status
