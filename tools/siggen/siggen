#!/bin/bash
# Control the signal generator board (tools/siggen: rp2350.py or esp32c6.py running as its
# main.py) over the UART (/dev/serial0) or over USB (/dev/ttyACM*) - whichever answers.
#
#   siggen shape sine freq 2k   shape: square sine triangle saw; frequency (Hz, k, M)
#   siggen duty 25              duty (%) of the square wave - commands combine in any order
#   siggen on | off             start / stop the output
#   siggen get | ping | probe   settings / link check / the board reads its output back
#   siggen flash tools/siggen/rp2350.py   upload a program as the board's main.py, restart it
#
# Every command prints the board's answer ("ok board=... shape=... freq=..." or "err ...").
# SIGGEN_PORT sets the port instead of looking for one (115200 baud).

usage() {
    sed -n '2,12s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}
[ $# -eq 0 ] && set -- get
case "$1" in -h|--help|help) usage ;; esac

open_port() {  # open_port <dev>: fd 3 on it, raw 115200
    stty -F "$1" 115200 raw -echo -hupcl 2>/dev/null || return 1
    exec 3<>"$1"
}

ask() {  # ask <line> [file] [seconds]: send a command (+ a file), answer -> $reply
    local file=$2 wait=${3:-2}
    while read -r -t 0.05 -u 3 _; do :; done  # drop anything stale
    printf '%s\n' "$1" >&3
    [ -n "$file" ] && cat "$file" >&3
    read -r -t "$wait" -u 3 reply || return 1
    reply=${reply%$'\r'}
}

find_port() {
    local p
    for p in ${SIGGEN_PORT:-/dev/serial0 /dev/ttyACM*}; do
        [ -e "$p" ] || continue
        if open_port "$p" && { [ -n "$SIGGEN_PORT" ] || { ask ping "" 0.5 && [ "$reply" = pong ]; }; }; then
            PORT=$p
            return 0
        fi
        exec 3>&-
    done
    echo "no signal generator board answers (${SIGGEN_PORT:-/dev/serial0, /dev/ttyACM*})" >&2
    exit 1
}

send() {  # send <line> [file]: print the answer, remember errors
    local wait=2
    [ -n "$2" ] && wait=$(( $(stat -c %s "$2") / 5000 + 10 ))
    if ask "$1" "$2" "$wait"; then
        echo "$reply"
        [[ $reply == err* ]] && status=1
    else
        echo "no answer from the board on $PORT" >&2
        exit 1
    fi
}

find_port
status=0
while [ $# -gt 0 ]; do
    case "$1" in
        freq|duty|shape)
            [ $# -ge 2 ] || usage 1
            send "$1 $2"
            shift 2 ;;
        flash)
            [ $# -ge 2 ] && [ -f "$2" ] || usage 1
            send "put main.py $(stat -c %s "$2")" "$2"
            [ $status = 0 ] && send reset
            shift 2 ;;
        on|off|get|ping|probe)
            send "$1"
            shift ;;
        *)
            echo "unknown: $1" >&2
            usage 1 ;;
    esac
done
exit $status
