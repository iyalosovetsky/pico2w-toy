#!/bin/bash
# Control the signal generator board (a Tiny 2350 running tools/siggen/rp2350.py as its
# main.py) over the UART (/dev/serial0) or over USB (/dev/ttyACM*) - whichever answers.
#
#   siggen shape sine freq 2k   shape: square sine triangle saw; frequency (Hz, k, M)
#   siggen duty 25              duty (%) of the square wave - commands combine in any order
#   siggen on | off             start / stop the output
#   siggen get | ping | probe   settings / link check / the board reads its output back
#   siggen adc                  voltages on the board's ADC inputs (RP2350: GP26-29)
#   siggen scope 100k [1.65]    oscilloscope capture on GP26: rate (samples/s), trigger level (V)
#   siggen logic 1M [0] [turbo] logic analyzer capture on J703.2..7: rate, trigger channel 0..5;
#                               turbo - the turbo clock for the capture, up to half of it
#   siggen turbo 300            the fast mode's clock, 150..300 MHz (default 200)
#   siggen decode uart 9600 [test] | decode i2c [test] | decode spi 0 [test]   protocol decoder
#   siggen uart 115200 [8E1] [half] [inv] [wait=200] 05 00 06 6F   UART tester on J703: sends the
#                               bytes on J703.4 (TX), prints the reply from J703.5 (RX); half - a 1-wire
#                               bus (TX through 1 kOhm), the own echo is dropped; inv - inverted levels
#   siggen lcd st7789-240x240 [all|colors|bars|grid|text]   display tester (siggen lcd - the models;
#                               epd4in2bwr - WeAct 4.2" black / white / red e-Paper, ~20 s a refresh)
#   siggen bl 60                TFT backlight on J703.2, 0..100 % (the generator output goes off)
#   siggen power | doze         is the board dozing (48 MHz after 30 s idle, output off) / doze now
#   siggen flash tools/siggen/rp2350.py   upload a program as the board's main.py, restart it
#
# Every command prints the board's answer ("ok board=... shape=... freq=..." or "err ...").
# SIGGEN_PORT sets the port instead of looking for one (115200 baud).

usage() {
    sed -n '2,25s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}
[ $# -eq 0 ] && set -- get
case "$1" in -h|--help|help) usage ;; esac

open_port() {  # open_port <dev>: fd 3 on it, raw 115200
    stty -F "$1" 115200 raw -echo -hupcl 2>/dev/null || return 1
    exec 3<>"$1"
}

ask() {  # ask <line> [file] [seconds]: send a command (+ a file), answer -> $reply
    local file=$2 wait=${3:-2}
    while read -r -t 0.05 -u 3 _; do :; done  # drop anything stale
    printf '%s\n' "$1" >&3
    if [ -n "$file" ]; then  # put: the board says "ok send" before it takes the file
        read -r -t 2 -u 3 reply || return 1
        reply=${reply%$'\r'}
        [ "$reply" = "ok send" ] || return 0
        cat "$file" >&3
    fi
    read -r -t "$wait" -u 3 reply || return 1
    reply=${reply%$'\r'}
}

wait_board() {  # after a reset: until the board answers again (it has to go away first)
    local i p ports=$PORT
    exec 3>&-  # let go of the port: a USB board that comes back finds it free (same ttyACM)
    [[ $PORT == /dev/ttyACM* ]] && ports="$PORT /dev/ttyACM*"
    sleep 1.5
    for i in $(seq 20); do
        for p in $ports; do
            if [ -e "$p" ] && open_port "$p" && ask ping "" 0.5 && [ "$reply" = pong ]; then
                PORT=$p
                echo "ok board back on $PORT"
                return 0
            fi
            exec 3>&-
        done
        sleep 0.5
    done
    echo "the board did not come back on $PORT" >&2
    status=1
}

find_port() {
    local p
    for p in ${SIGGEN_PORT:-/dev/serial0 /dev/ttyACM*}; do
        [ -e "$p" ] || continue
        if open_port "$p" && { [ -n "$SIGGEN_PORT" ] || { ask ping "" 0.5 && [ "$reply" = pong ]; }; }; then
            PORT=$p
            return 0
        fi
        exec 3>&-
    done
    echo "no signal generator board answers (${SIGGEN_PORT:-/dev/serial0, /dev/ttyACM*})" >&2
    exit 1
}

send() {  # send <line> [file] [seconds]: print the answer, remember errors
    local wait=${3:-2}
    [ -n "$2" ] && wait=$(( $(stat -c %s "$2") / 5000 + 10 ))
    if ask "$1" "$2" "$wait"; then
        echo "$reply"
        [[ $reply == err* ]] && status=1
        return 0
    else
        echo "no answer from the board on $PORT" >&2
        exit 1
    fi
}

find_port
status=0
while [ $# -gt 0 ]; do
    case "$1" in
        lcd)  # lcd <model> [pattern]: display tester (an e-Paper refresh takes seconds)
            shift
            send "lcd $*" "" 60
            break ;;
        uart)  # uart <baud> [fmt] [half] [inv] [wait=ms] [hex...]: the rest of the line goes to the board
            shift
            send "uart $*" "" 8
            break ;;
        decode)  # decode uart|i2c|spi [args...] [test]: the rest of the line goes to the board
            shift
            send "decode $*" "" 8
            break ;;
        logic)  # logic <rate> [channel]: one capture
            [ $# -ge 2 ] || usage 1
            args="logic $2"; shift 2
            [ $# -ge 1 ] && [[ $1 =~ ^[0-5]$ ]] && { args="$args $1"; shift; }
            [ $# -ge 1 ] && [ "$1" = turbo ] && { args="$args turbo"; shift; }
            send "$args" "" 5 ;;
        scope)  # scope <rate> [level]: one capture, printed as the board sends it
            [ $# -ge 2 ] || usage 1
            if [ $# -ge 3 ] && [[ $3 =~ ^[0-9.]+$ ]]; then send "scope $2 $3"; shift 3; else send "scope $2"; shift 2; fi ;;
        turbo)  # turbo [MHz]: show / set the fast mode's clock
            if [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]]; then send "turbo $2"; shift 2; else send turbo; shift; fi ;;
        freq|duty|shape|bl)
            [ $# -ge 2 ] || usage 1
            send "$1 $2"
            shift 2 ;;
        flash)
            [ $# -ge 2 ] && [ -f "$2" ] || usage 1
            send "put main.py $(stat -c %s "$2")" "$2"
            [ $status = 0 ] && send reset && wait_board
            shift 2 ;;
        on|off|get|ping|probe|adc|power|doze)
            send "$1"
            shift ;;
        *)
            echo "unknown: $1" >&2
            usage 1 ;;
    esac
done
exit $status
